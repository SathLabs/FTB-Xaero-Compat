{
  "schemaVersion": 1,
  "id": "ftbxaerocompat",
  "version": "${version}",
  "name": "FTB Chunks x Xaero's Map Compat",
  "description": "Provides compatability between FTB Chunks and Xaeros world- and minimap",
  "authors": [
    "Satherov"
  ],
  "contact": {
    "sources": "https://github.com/Satherov/FTB-Xaero-Compat"
  },
  "license": "CC0-1.0",
  "icon": "assets/ftbxaerocompat/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.satherov.ftbxaerocompat.fabric.FTBXaeroCompatFabric"
    ],
    "client": [
      "dev.satherov.ftbxaerocompat.fabric.FTBXaeroCompatFabricClient"
    ]
  },
  "mixins": [
    "ftbxaerocompat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.0",
